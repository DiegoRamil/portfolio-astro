---
import TerminalLine from "@/components/terminal-line.astro";
import currentWork from "@/data/current_work.json";
---

<TerminalLine prompt="cat work.txt" heading="Current work">
  Currently working as {currentWork.role} at{" "}
  <a
    class="text-indigo-500 border-indigo-500 border-b-2"
    href={currentWork.url}
    target="_blank"
    rel="noopener"
  >
    {currentWork.name}
  </a>
</TerminalLine>

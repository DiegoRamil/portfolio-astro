<div class="p-4 bg-black text-green-500 min-h-screen">
  <div class="mb-4 flex items-center">
    <button
      type="button"
      class="w-3 h-3 rounded-full bg-red-500 mr-2"
      aria-label="Close window"
      data-terminal-action="close"
    ></button>
    <button
      type="button"
      class="w-3 h-3 rounded-full bg-yellow-500 mr-2"
      aria-label="Minimize window"
      data-terminal-action="minimize"
    ></button>
    <button
      type="button"
      class="w-3 h-3 rounded-full bg-green-500"
      aria-label="Toggle fullscreen"
      data-terminal-action="fullscreen"
    ></button>
  </div>
  <div class="terminal-output overflow-hidden">
    <slot />
  </div>
  <div class="terminal-cursor animate-pulse" aria-hidden="true">_</div>
  <div
    role="status"
    aria-live="polite"
    class="terminal-toast fixed bottom-4 right-4 max-w-sm border border-green-500 bg-black p-4 text-sm text-green-500"
    hidden
  >
    <p class="font-bold">Error</p>
    <p>There's no way to minimize a window in the browser.</p>
  </div>
</div>

<script>
  const toast = document.querySelector<HTMLElement>(".terminal-toast");
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  const actions: Record<string, () => void> = {
    close: () => window.close(),
    // there's no way to minimize a window in the browser; with electron we can achieve this.
    minimize: () => {
      if (!toast) return;
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => (toast.hidden = true), 4000);
    },
    fullscreen: () => {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        document.documentElement.requestFullscreen();
      }
    },
  };

  document.querySelectorAll<HTMLElement>("[data-terminal-action]").forEach((button) => {
    button.addEventListener("click", () => actions[button.dataset.terminalAction ?? ""]?.());
  });
</script>

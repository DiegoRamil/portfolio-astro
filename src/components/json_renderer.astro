---
const { data, linkRel = "noopener" } = Astro.props;

const isLink = (value) => typeof value === "string" && value.startsWith("https://");
const formatJsonValue = (value) => (typeof value === "string" ? `'${value}'` : String(value));
---

<div>
  [
  <ol class="ml-4">
    {
      data?.map((item, idx) => (
        <li>
          {"{ "}
          <br />
          <div class="ml-5">
            {Object.entries(item).map(([key, value]) => (
              <span>
                {key}:{" "}
                {isLink(value) ? (
                  <>
                    '<a
                      href={value}
                      target="_blank"
                      rel={linkRel}
                      class="text-indigo-500 border-indigo-500 border-b-2"
                    >{value}</a>'
                  </>
                ) : (
                  formatJsonValue(value)
                )}
                <br />
              </span>
            ))}
          </div>
          {idx === data.length - 1 ? "}" : "},"}
        </li>
      ))
    }
  </ol>
  ]
</div>

---
import '@/styles/globals.css'
import contact from '@/data/contact.json';
import currentWork from '@/data/current_work.json';
import certifications from '@/data/certifications.json';
import education from '@/data/education.json';
import { getContentLastModified } from '@/lib/last-modified.mjs';

const metadata = {
  title: "Diego Ramil Alvarez - Full Stack Web Developer in Spain",
  description: "Official portfolio of Diego Ramil Alvarez, Full Stack Web Developer in Spain: experience, projects, AWS certification and contact links.",
  author: "Diego Ramil Alvarez",
  url: "https://diegoramil.com/",
  image: "https://diegoramil.com/og.png",
  imageAlt: "Diego Ramil Alvarez - Full Stack Web Developer in Spain, terminal-style portfolio card",
};

const {
  title = metadata.title,
  description = metadata.description,
  canonicalUrl = metadata.url,
  image = metadata.image,
  robots = "index, follow, max-image-preview:large",
  includeProfileSchema = true,
} = Astro.props;

const personId = `${metadata.url}#person`;
const profileId = `${metadata.url}#profile`;
const websiteId = `${metadata.url}#website`;
const contentLastModified = getContentLastModified().toISOString();
// "30 January 2026" -> "2026-01-30" and "June 2025" -> "2025-06", parsed as UTC so the day never shifts
const toIsoDate = (date) => {
  const iso = new Date(`${date} UTC`).toISOString();
  return /^\d{1,2} /.test(date) ? iso.slice(0, 10) : iso.slice(0, 7);
};

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Diego Ramil Alvarez",
      alternateName: ["Diego Ramil", "Diego Ramil Álvarez"],
      url: metadata.url,
      jobTitle: "Full Stack Web Developer",
      description: "Diego Ramil Alvarez is a Full Stack Developer based in Narón, Galicia (Spain), focused on JavaScript, TypeScript, React, Astro, Node.js and modern web development.",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Narón",
        addressRegion: "Galicia",
        addressCountry: "ES"
      },
      sameAs: contact.map((profile) => profile.url),
      knowsAbout: [
        "JavaScript",
        "TypeScript",
        "React",
        "Astro",
        "Node.js",
        "Spring Boot",
        "Docker",
        "Kubernetes",
        "CI/CD",
        "Domain-Driven Design",
        "Scrum",
        ".NET Framework",
        "Microsoft SQL Server",
        "Microsoft Azure",
        "AWS"
      ],
      worksFor: {
        "@type": "Organization",
        name: currentWork.name,
        url: currentWork.url
      },
      alumniOf: education.map((school) => ({
        "@type": "EducationalOrganization",
        name: school.name
      })),
      hasCredential: [
        ...certifications.map((certification) => ({
          "@type": "EducationalOccupationalCredential",
          name: certification.name,
          credentialCategory: "certification",
          url: certification.url,
          validFrom: toIsoDate(certification.issued),
          validUntil: certification.expires && toIsoDate(certification.expires),
          recognizedBy: {
            "@type": "Organization",
            name: certification.issuer
          }
        })),
        ...education.map((school) => ({
          "@type": "EducationalOccupationalCredential",
          name: school.degree,
          credentialCategory: "degree",
          recognizedBy: {
            "@type": "EducationalOrganization",
            name: school.name
          }
        }))
      ],
      mainEntityOfPage: {
        "@id": profileId
      }
    },
    {
      "@type": "ProfilePage",
      "@id": profileId,
      name: "Diego Ramil Alvarez - Full Stack Web Developer",
      url: metadata.url,
      headline: "Full Stack Web Developer in Spain",
      description: metadata.description,
      inLanguage: "en",
      dateModified: contentLastModified,
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: metadata.image,
        width: 1200,
        height: 630
      },
      isPartOf: {
        "@id": websiteId
      },
      mainEntity: {
        "@id": personId
      }
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Diego Ramil Alvarez Portfolio",
      url: metadata.url,
      description: "Official portfolio and professional website of Diego Ramil Alvarez, Full Stack Web Developer.",
      inLanguage: "en",
      author: {
        "@id": personId
      },
      publisher: {
        "@id": personId
      }
    }
  ]
};
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content={metadata.author}>
    <meta name="robots" content={robots}>
    <meta name="theme-color" content="#000000">
    <meta name="application-name" content="Diego Ramil Alvarez Portfolio">
    <meta name="apple-mobile-web-app-title" content="Diego Ramil Alvarez">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Diego Ramil Alvarez Portfolio">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    {canonicalUrl && <meta property="og:url" content={canonicalUrl}>}
    <meta property="og:image" content={image}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={metadata.imageAlt}>
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    <meta name="twitter:image:alt" content={metadata.imageAlt}>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    {includeProfileSchema && <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />}
  </head>
  <body class="bg-black text-green-500 font-mono"><slot /></body>
</html>
